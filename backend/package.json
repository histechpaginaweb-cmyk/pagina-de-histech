{
  "name": "histech-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de HISTECH (API de productos + panel admin) — Render. Persistencia (tarjetas e imágenes) en Cloudflare R2. Sin base de datos.",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "postinstall": "prisma generate --schema portal/prisma/schema.prisma",
    "portal:generate": "prisma generate --schema portal/prisma/schema.prisma",
    "portal:migrate": "prisma migrate deploy --schema portal/prisma/schema.prisma",
    "portal:migrate:dev": "prisma migrate dev --schema portal/prisma/schema.prisma",
    "portal:push": "prisma db push --schema portal/prisma/schema.prisma",
    "portal:seed": "node portal/seed.js",
    "catalog:seed": "node catalog/seed.js",
    "portal:studio": "prisma studio --schema portal/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.2",
    "prisma": "^6.2.1",
    "resend": "^4.8.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  }
}
